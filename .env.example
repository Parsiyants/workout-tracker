# Скопировать в .env и поменять перед публичным деплоем

# --- общие секреты ---
JWT_SECRET=dev-secret-change-me
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345

# --- storage ---
# Пусто = относительные ссылки (/files/...), удобно когда всё на одном домене
STORAGE_PUBLIC_URL=
ALLOWED_ORIGINS=http://localhost:5173,https://workout-tracker.abm-order.ru

# --- прод-стек (docker-compose.server.yml) ---
# Пароль БД: если меняете после первого запуска, данные останутся на старом пароле
POSTGRES_USER=tracker
POSTGRES_PASSWORD=tracker
POSTGRES_DB=tracker
